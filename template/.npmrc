# hookreel-engine comes from its GitHub repo; npm 12 blocks git dependencies unless allowed.
# root = only this studio's direct dependencies (the engine), nothing deeper.
allow-git=root
# No allow-scripts here: the engine has no install scripts. npm 12 refuses allow-scripts passed in from
# outside a project (EALLOWSCRIPTS), and `npm run` hands a user-level ~/.npmrc allow-scripts to the child
# npm as npm_config_allow_scripts, so `npm run update-engine` drops that variable before it installs.
