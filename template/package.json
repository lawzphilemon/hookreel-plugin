{
  "name": "hookreel-studio",
  "version": "2.0.0",
  "description": "HyperFrames studio for hookreel videos: one HTML project per video in reels/<id>/, audio and checks in plain Node",
  "license": "MIT",
  "private": true,
  "type": "module",
  "dependencies": {
    "@remotion/install-whisper-cpp": "4.0.534"
  },
  "scripts": {
    "postinstall": "node scripts/make-sfx.mjs && node scripts/prepare-sounds.mjs",
    "assemble": "node --no-warnings scripts/assemble.mjs",
    "dev": "npx --yes hyperframes@0.8.188 preview",
    "hf": "npx --yes hyperframes@0.8.188",
    "render": "node --no-warnings scripts/render.mjs",
    "check": "node scripts/check-video.mjs",
    "sfx": "node scripts/make-sfx.mjs",
    "sounds": "node scripts/prepare-sounds.mjs",
    "vo": "node --no-warnings scripts/prepare-vo.mjs",
    "tts": "node --no-warnings scripts/tts-vo.mjs",
    "words": "node scripts/word-times.mjs",
    "trim": "node --no-warnings scripts/trim-pauses.mjs",
    "music": "node --no-warnings scripts/make-music.mjs",
    "loudness": "node scripts/loudness.mjs",
    "fresh": "node --no-warnings scripts/fresh-check.mjs",
    "retention": "node --no-warnings scripts/retention.mjs",
    "contrast": "node scripts/contrast.mjs",
    "pace": "node --no-warnings scripts/pace.mjs --self-test",
    "refcuts": "node --no-warnings scripts/ref-cuts.mjs",
    "lib-sfx": "node scripts/lib-sfx.mjs",
    "sheets": "node --no-warnings scripts/sheets.mjs",
    "sweep": "node --no-warnings scripts/sheets.mjs --sweep",
    "preview": "node scripts/preview.mjs",
    "cover": "node --no-warnings scripts/covers.mjs"
  },
  "engines": {
    "node": ">=22.18"
  }
}
