{
  "name": "hookreel-studio",
  "version": "2.0.0",
  "description": "A hookreel brand studio: brand data, scenes and assets only. Every tool comes from hookreel-engine (npm run update-engine for the latest).",
  "license": "MIT",
  "private": true,
  "type": "module",
  "dependencies": {
    "hookreel-engine": "github:lawzphilemon/hookreel-plugin#main"
  },
  "scripts": {
    "postinstall": "hookreel sfx && hookreel sounds",
    "update-engine": "node -e \"delete process.env.npm_config_allow_scripts; require('child_process').execSync('npm install hookreel-engine@github:lawzphilemon/hookreel-plugin#main', { stdio: 'inherit' })\"",
    "dev": "hookreel hf preview",
    "assemble": "hookreel assemble",
    "render": "hookreel render",
    "check": "hookreel check",
    "sfx": "hookreel sfx",
    "sounds": "hookreel sounds",
    "vo": "hookreel vo",
    "tts": "hookreel tts",
    "words": "hookreel words",
    "trim": "hookreel trim",
    "music": "hookreel music",
    "loudness": "hookreel loudness",
    "fresh": "hookreel fresh",
    "retention": "hookreel retention",
    "contrast": "hookreel contrast",
    "pace": "hookreel pace",
    "refcuts": "hookreel refcuts",
    "lib-sfx": "hookreel lib-sfx",
    "sheets": "hookreel sheets",
    "sweep": "hookreel sweep",
    "preview": "hookreel preview",
    "cover": "hookreel cover",
    "kit-finish": "hookreel kit-finish",
    "hf": "hookreel hf"
  },
  "engines": {
    "node": ">=22.18"
  }
}
